# Copy this file to .env and set real values. .env is gitignored —
# never commit real credentials.

PORT=3000

# Basic auth credentials for /admin.html and write endpoints.
ADMIN_USER=admin
ADMIN_PASS=change-me-to-something-long-and-random

# Set to "true" only after a domain + TLS (Caddy) is set up. Leave "false"
# while running on a bare IP over plain HTTP, or the browser will try to
# upgrade asset requests to HTTPS and silently fail to load CSS/JS.
HTTPS_ENABLED=false
